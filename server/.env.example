# PostgreSQL connection string used by the app
# (on Neon: the "-pooler" connection string, with ?sslmode=require)
DATABASE_URL="postgresql://sweety:sweety@localhost:5432/sweety?schema=public"

# Direct (non-pooled) connection used by `prisma migrate`.
# Locally this is the same as DATABASE_URL; on Neon use the host WITHOUT "-pooler".
DIRECT_URL="postgresql://sweety:sweety@localhost:5432/sweety?schema=public"

# Separate database used by the integration tests (it is wiped on every test run!)
TEST_DATABASE_URL="postgresql://sweety:sweety@localhost:5432/sweety_test?schema=public"

# Port the API listens on
PORT=4000

# Secret used to sign JWT access tokens. REQUIRED, at least 32 characters.
# The API refuses to start with this placeholder. Generate one with:  openssl rand -hex 32
JWT_SECRET="change-me-run-openssl-rand-hex-32"

# How long a login token is valid (jsonwebtoken format, e.g. 1h, 7d)
JWT_EXPIRES_IN="1d"

# Allowed origin for the Next.js client (CORS)
CLIENT_ORIGIN="http://localhost:3000"

# Time zone used to decide what "today" is for the "date cannot be in the future" rule
APP_TIMEZONE="Asia/Kolkata"

# Number of reverse proxies in front of the API (0 locally, usually 1 when hosted),
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# Login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20

# The seed script refuses to create the public demo account on a production or remote
# database unless this is "true".
# ALLOW_DEMO_SEED=true
